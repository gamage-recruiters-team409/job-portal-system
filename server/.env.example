NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_local_secret
# Session-token lifetime (jsonwebtoken expiresIn format)
JWT_EXPIRES_IN=7d
# Cost factor for bcrypt password hashing
BCRYPT_SALT_ROUNDS=10
CLIENT_URL=http://localhost:5173
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USER=your_brevo_login
BREVO_PASSWORD=your_brevo_smtp_key
# Sender identity used on verification and password emails (must match a verified sender in your SMTP provider)
EMAIL_FROM_NAME=Gamage Recruiters
EMAIL_FROM_ADDRESS=your_verified_sender_email@yourdomain.com
# JWT expiry for the email-verification token (e.g. 24h)
EMAIL_VERIFICATION_EXPIRES_IN=24h
# JWT expiry for the password-reset token (e.g. 30m)
RESET_PASSWORD_EXPIRES_IN=30m
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Superadmin Seeding Credentials
SUPERADMIN_NAME=Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_this_to_a_secure_password
